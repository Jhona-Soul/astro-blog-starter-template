---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
}

const {
  title = "AppEx Analytica | Monitoreo Industrial y Data Logging",
  description = "AppEx Analytica digitaliza tus máquinas conectando PLCs y sensores para monitorear, analizar y optimizar tu producción en tiempo real. Soluciones de data logging industrial a medida.",
  canonical = "https://appexanalytica.com/",
} = Astro.props;

const siteName = "AppEx Analytica";
const ogImage = "https://appexanalytica.com/og-image.png";

const schemaWebSite = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "AppEx Analytica",
  "alternateName": ["AppEx", "appexanalytica"],
  "url": "https://appexanalytica.com"
});

const schemaOrganization = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "AppEx Analytica",
  "alternateName": "AppEx",
  "url": "https://appexanalytica.com",
  "logo": "https://appexanalytica.com/favicon-64.png",
  "sameAs": [],
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+54-11-5318-2734",
    "contactType": "sales",
    "email": "ventas@appex.com",
    "areaServed": "AR",
    "availableLanguage": "Spanish"
  }
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="/favicon-64.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="es_AR" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={schemaWebSite} />

    <script type="application/ld+json" set:html={schemaOrganization} />
  </head>
  <body>
    <slot />
  </body>
</html>